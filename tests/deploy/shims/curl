#!/bin/bash
echo "curl $*" >> "$HOME/calls"
[ "${CURL_FAIL:-0}" = 1 ] && exit 22
url="${!#}"
case "$url" in
*/api/plans) printf 401 ;;
*/robots.txt) printf 'User-Agent: *\nSitemap: https://%s/sitemap.xml\n' "${ROBOTS_SITE:-shirube.example}" ;;
*/api/health)
	version=${HEALTH_VERSION:-$(sed -n 's/^APP_VERSION=//p' .env.version 2> /dev/null)}
	printf '{"status":"ok","version":"%s","database":"%s","queue":"ok","openai":"ok"}' \
		"${version:-unknown}" "${HEALTH_DATABASE:-ok}"
	;;
esac
exit 0
