            "type": "array",
            "title": "Semesters"
          },
          "unplaced": {
            "items": {
              "$ref": "#/components/schemas/CourseOut"
            },
            "type": "array",
            "title": "Unplaced"
          },
          "unlinked": {
            "items": {
              "$ref": "#/components/schemas/UnlinkedOut"
            },
            "type": "array",
            "title": "Unlinked"
          }
        },
        "type": "object",
        "required": [
          "profile",
          "semesters",
          "unplaced",
          "unlinked"
