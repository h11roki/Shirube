        "title": "SlotOut"
      },
      "Term": {
        "type": "string",
        "enum": [
          "spring",
          "autumn"
        ],
        "title": "Term"
      },
      "UnlinkedOut": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          },
          "prerequisite_for": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
