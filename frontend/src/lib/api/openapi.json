        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PlacedCourseOut": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "relevance": {
            "$ref": "#/components/schemas/Relevance"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          },
          "prerequisite_for": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Prerequisite For"
          },
          "syllabus_code": {
            "type": "string",
            "title": "Syllabus Code"
          },
          "section_code": {
            "type": "string",
            "title": "Section Code"
          },
          "class_code": {
            "anyOf": [
              {
                "type": "string"
              },
