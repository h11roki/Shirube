                "$ref": "#/components/schemas/ResultOut"
              },
              {
                "type": "null"
              }
            ]
          },
          "failure": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Failure"
          }
        },
        "type": "object",
        "required": [
          "id",
          "status",
          "conditions",
          "result",
          "failure"
        ],
        "title": "PlanOut"
