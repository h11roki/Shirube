        "type": "object",
        "required": [
          "occupation",
          "department",
          "year",
          "grade",
          "term",
          "chosen_classes",
          "credit_limit"
        ],
        "title": "ConditionsOut"
      },
      "CourseOut": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "relevance": {
            "$ref": "#/components/schemas/Relevance"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          },
          "prerequisite_for": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Prerequisite For"
          },
          "syllabus_code": {
            "type": "string",
            "title": "Syllabus Code"
          }
        },
        "type": "object",
        "required": [
          "name",
          "relevance",
          "reason",
          "prerequisite_for",
          "syllabus_code"
