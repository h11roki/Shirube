              "type": "string"
            },
            "type": "array",
            "title": "Class Codes"
          }
        },
        "type": "object",
        "required": [
          "name",
          "class_codes"
        ],
        "title": "ClassChoiceOut"
      },
      "ClassChoicesOut": {
        "properties": {
          "courses": {
            "items": {
              "$ref": "#/components/schemas/ClassChoiceOut"
            },
            "type": "array",
            "title": "Courses"
