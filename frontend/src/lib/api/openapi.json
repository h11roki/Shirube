        "title": "PlacedCourseOut"
      },
      "PlanIn": {
        "properties": {
          "occupation": {
            "type": "string",
            "maxLength": 100,
            "title": "Occupation"
          },
          "grade": {
            "type": "integer",
            "maximum": 4.0,
            "minimum": 1.0,
            "title": "Grade"
          },
          "term": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Term"
              },
              {
                "type": "null"
              }
            ]
          },
          "department": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Department"
          },
          "chosen_classes": {
            "additionalProperties": {
              "type": "string",
              "maxLength": 100
            },
            "propertyNames": {
              "maxLength": 100
            },
            "type": "object",
            "maxProperties": 50,
            "title": "Chosen Classes"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "occupation",
          "grade",
          "department"
        ],
        "title": "PlanIn"
      },
