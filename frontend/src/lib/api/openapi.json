          "courses": {
            "items": {
              "$ref": "#/components/schemas/PlacedCourseOut"
            },
            "type": "array",
            "title": "Courses"
          },
          "continuing": {
            "items": {
              "$ref": "#/components/schemas/PlacedCourseOut"
            },
            "type": "array",
            "title": "Continuing"
          }
        },
        "type": "object",
        "required": [
          "grade",
          "term",
          "credits",
          "courses",
          "continuing"
        ],
        "title": "SemesterPlanOut"
      },
      "SlotOut": {
        "properties": {
          "weekday": {
            "$ref": "#/components/schemas/Weekday"
