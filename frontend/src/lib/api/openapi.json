          "grade": {
            "type": "integer",
            "title": "Grade"
          },
          "term": {
            "$ref": "#/components/schemas/Term"
          },
          "chosen_classes": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Chosen Classes"
          },
          "credit_limit": {
            "type": "integer",
            "title": "Credit Limit"
          }
